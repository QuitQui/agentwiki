---
export interface GraphNode {
  id: string
  title: string
  type: string
  color: string
}

export interface GraphEdge {
  source: string
  target: string
  type: string
}

interface Props {
  nodes: GraphNode[]
  edges: GraphEdge[]
}

const { nodes, edges } = Astro.props
---

<div id="global-graph" style="width: 100%; height: 520px; background: rgba(15,23,42,.9); border-radius: 16px; border: 1px solid var(--border);"></div>

<script define:vars={{ nodes, edges }}>
  const CYTOSCAPE_CDN = 'https://unpkg.com/cytoscape@3.30.2/dist/cytoscape.min.js'

  async function loadCytoscape() {
    if (window.cytoscape) return window.cytoscape
    await new Promise((resolve, reject) => {
      const s = document.createElement('script')
      s.src = CYTOSCAPE_CDN
      s.onload = resolve
      s.onerror = reject
      document.head.appendChild(s)
    })
    return window.cytoscape
  }

  async function initGraph() {
    const container = document.getElementById('global-graph')
    if (!container) return

    const cy = await loadCytoscape()

    const instance = cy({
      container,
      elements: [
        ...nodes.map(n => ({
          group: 'nodes',
          data: { id: n.id, label: n.title.slice(0, 20), color: n.color, type: n.type },
        })),
        ...edges.map(e => ({
          group: 'edges',
          data: { source: e.source, target: e.target, label: e.type },
        })),
      ],
      layout: {
        name: 'cose',
        animate: true,
        animationDuration: 600,
        nodeRepulsion: 4500,
        idealEdgeLength: 80,
        gravity: 0.3,
      },
      style: [
        {
          selector: 'node',
          style: {
            'background-color': 'data(color)',
            'border-color': 'data(color)',
            'border-width': 1.5,
            'border-opacity': 0.8,
            label: 'data(label)',
            'font-size': 10,
            color: '#f1f5f9',
            'text-valign': 'bottom',
            'text-margin-y': 4,
            'text-outline-width': 2,
            'text-outline-color': '#0f172a',
            width: 18,
            height: 18,
          },
        },
        {
          selector: 'edge',
          style: {
            width: 1,
            'line-color': 'rgba(100,116,139,.45)',
            'target-arrow-color': 'rgba(100,116,139,.45)',
            'target-arrow-shape': 'triangle',
            'curve-style': 'bezier',
            'arrow-scale': 0.7,
          },
        },
        {
          selector: 'node:selected',
          style: { 'border-width': 3, 'border-color': '#38bdf8' },
        },
      ],
    })

    // Click node → navigate to its page
    instance.on('tap', 'node', (evt) => {
      const id = evt.target.id()
      const slug = id.replace(/:/g, '__').replace(/\//g, '-')
      window.location.href = `/nodes/${slug}`
    })

    instance.on('mouseover', 'node', () => { container.style.cursor = 'pointer' })
    instance.on('mouseout', 'node', () => { container.style.cursor = '' })
  }

  initGraph()
</script>
